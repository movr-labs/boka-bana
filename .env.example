SESSION_SECRET="byt-till-en-lang-slumpad-hemlighet"

# Satt dessa i Vercel nar du har kopplat en KV/Redis-databas.
# Utan dem fungerar appen lokalt med minneslagring, men inte persistent i produktion.
KV_REST_API_URL=""
KV_REST_API_TOKEN=""

# Lokal utveckling använder .data/bokabana-database.json när KV saknas.
# Sätt bara true om du uttryckligen vill ha flyktig minneslagring.
BOKABANA_USE_MEMORY_STORE="false"

# Matchi checkout enligt MOVR-modellen:
# Quote hämtas via Matchis confirm-modal endpoint när den svarar publikt, annars faller appen tillbaka till visat pris.
MATCHI_REMOTE_QUOTE_ENABLED="true"
MATCHI_ALLOW_ESTIMATED_PRICE_FALLBACK="false"
MATCHI_QUOTE_PATH="/bookingPayment/updateConfirmModalModel"
MATCHI_QUOTE_TTL_SECONDS="600"

# Om ni får en verifierad init/status-endpoint från Matchi kan den kopplas här.
# Utan MATCHI_CHECKOUT_INIT_PATH skapas en manuell Matchi-länk som fallback.
MATCHI_CHECKOUT_INIT_PATH=""
MATCHI_CHECKOUT_INIT_METHOD="POST"
MATCHI_CHECKOUT_STATUS_PATH=""
MATCHI_ASSUME_UNAVAILABLE_IS_BOOKED="false"
